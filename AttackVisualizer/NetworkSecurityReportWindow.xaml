<Window x:Class="AttackVisualizer.NetworkSecurityReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AttackVisualizer"
        mc:Ignorable="d"
        Title="NetworkSecurityReportWindow" Width="900" Height="650"
        Background="#121212"
        Foreground="White"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Network Security Report"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#00E5FF"/>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <Border Background="#1E1E1E" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Risk Score"/>
                        <ProgressBar x:Name="RiskBar" Height="18" Maximum="100"/>
                        <TextBlock x:Name="RiskText"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Attack Timeline"/>
                        <ListBox x:Name="TimelineList"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" Padding="15">
                    <StackPanel>
                        <TextBlock Text="MITRE ATTACK"/>
                        <ListView x:Name="MitreList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" Width="80" DisplayMemberBinding="{Binding Id}"/>
                                    <GridViewColumn Header="Technique" Width="220" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Tactic" Width="120" DisplayMemberBinding="{Binding Tactic}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <Border Background="#1E1E1E" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Recommendations"/>
                        <ListBox x:Name="RecommendationsList"/>
                    </StackPanel>
                </Border>

                <Button Content="💾 Export PDF"
                        Height="40"
                        Click="ExportPdf_Click"/>
                <Button Content="Close"
                        Height="40"
                        Margin="0,10,0,0"
                        Click="Close_Click"/>
            </StackPanel>
            <!-- THEORETICAL REPORT SECTION -->
            <TextBox x:Name="ReportBox"
                     IsReadOnly="True"
                     Background="#000000"
                     Foreground="#CCCCCC"
                     BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" 
                     Margin="0,311,0,0"
                     Padding="5, 5, 5, 5"/>
        </Grid>
        
    </Grid>
</Window>

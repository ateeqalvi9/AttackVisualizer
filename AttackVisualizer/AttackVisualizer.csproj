    <PackageReference Include="NodeNetwork" Version="6.0.0" />
    <PackageReference Include="NodeNetworkToolkit" Version="6.0.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" />
    <PackageReference Include="ReactiveUI" Version="13.3.2" />
    <PackageReference Include="ReactiveUI.WPF" Version="13.3.2" />
    <PackageReference Include="Splat" Version="13.1.1" />
    <PackageReference Include="Splat.ReactiveUIExtensions" Version="1.0.2" />
  </ItemGroup>

</Project>

<Window x:Class="AttackVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CyberVis – Attack Visualizer" 
        Height="900" Width="1400"
        Background="#121212" 
        Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen">

    <!-- ================= GLOBAL STYLES ================= -->
    <Window.Resources>
        <!-- Menu Button -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Padding="15,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,0,1,0">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="CYBERVIS" Foreground="#00E5FF" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="ENTERPRISE SECURITY" Foreground="#666" FontSize="11"/>
                    <Separator Margin="0,15"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource MenuButton}" Click="AddAttacker_Click">💀 Threat Actor</Button>
                    <Button Style="{StaticResource MenuButton}" Click="AddFirewall_Click">🛡 Firewall</Button>
                    <Button Style="{StaticResource MenuButton}" Click="AddAV_Click">💊 Endpoint Protection</Button>
                    <Button Style="{StaticResource MenuButton}" Click="AddServer_Click">💾 Database</Button>
                    <Button Style="{StaticResource MenuButton}" Click="RemoveAssets_Click">❌ Remove Assets</Button>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="▶ EXECUTE SIMULATION"
                            Style="{StaticResource ActionButton}"
                            Background="#C50F1F"
                            Click="RunSimulation_Click"/>

                    <Button Content="📄 AUDIT REPORT"
                            Style="{StaticResource ActionButton}"
                            Background="#333"
                            Margin="0,10,0,0"
                            Click="ExportReport_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Column="1">

            <!-- ATTACK PATH CANVAS -->
            <Canvas x:Name="AttackCanvas"
                    Margin="40,66,40,40"
                    IsHitTestVisible="False"
                    Panel.ZIndex="0"/>

            <!-- LOG WINDOW -->
            <Border Margin="40,66,40,40"
                    Background="Black"
                    BorderBrush="#333"
                    BorderThickness="1"
                    CornerRadius="6"
                    Panel.ZIndex="1">

                <ListBox x:Name="LogBox"
                         Background="Transparent"
                         Foreground="#00FF41"
                         FontFamily="Consolas"
                         FontSize="16"/>
            </Border>
        </Grid>
    </Grid>
</Window>
